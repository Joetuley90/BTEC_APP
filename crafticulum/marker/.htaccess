# Marked PDFs can be large
<IfModule mod_php.c>
  php_value post_max_size 40M
  php_value memory_limit 512M
</IfModule>
<IfModule lsapi_module>
  php_value post_max_size 40M
  php_value memory_limit 512M
</IfModule>
# an old copy of the marking page, if it is still here, must not open on its own
<Files "app.html">
  Require all denied
</Files>
