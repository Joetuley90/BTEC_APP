# Serve pages as UTF-8 so symbols like · and – show correctly
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .txt

# Keep the settings file private
<Files "config.php">
  Require all denied
</Files>
Options -Indexes

# Install as an app
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>
</IfModule>

# Send pages smaller and faster
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Clean addresses: /about, /terms, /planning, /s/CODE and so on.
# Every old address still works. If your host has no mod_rewrite, nothing here runs and the site carries on as before.
<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On

  # old addresses move to the new ones (only when someone asks for the old one directly)
  RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)(terms|privacy|cookies|dpa|contact|app)\.html[?\s]
  RewriteRule ^(terms|privacy|cookies|dpa|contact|app)\.html$ %1%2 [R=301,L]
  RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)(about\.html|about|index\.html)[?\s]
  RewriteRule ^(about\.html|about|index\.html)$ %1 [R=301,L]

  # the front page, and the other public pages, with their search engine details filled in
  RewriteRule ^$ page.php?p=home [L,QSA]
  RewriteRule ^(terms|privacy|cookies|dpa|contact)$ page.php?p=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ page.php?p=sitemap [L]
  RewriteRule ^robots\.txt$ page.php?p=robots [L]

  # the app and its pages
  RewriteRule ^(app|signin|this-week|lessons|planning|results|second-marker|ai-tools|assistant|library|learners|roadmap|our-team|admin|settings)$ app.html [L]

  # a member of staff's profile page, and the team it belongs to
  RewriteRule ^([a-z0-9-]+)/team/([a-z0-9-]+)/?$ profile.php?c=$1&p=$2 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/team/?$ our-team [R=302,L]

  # a student's lesson or class page
  RewriteRule ^s/([A-Za-z0-9]+)$ page.php?p=student&id=$1 [L,QSA]
</IfModule>
